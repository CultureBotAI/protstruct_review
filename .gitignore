.DS_Store
.venv/
/.temp/
__pycache__/
*.pyc

# Benchmark download/work caches (scripts/bench_*.py). These hold deposited PDB,
# PISA JSON and reflection files — re-downloadable, and large. Both scripts now
# default outside the working tree, but an explicit `--cache .` should still not
# be committable.
.bench_cache_t16/
bench_cache_t16/
.bench_cache_t13/
bench_cache_t13/
schemas/json-schema/
/ref/phenix_docs/
.claude/scheduled_tasks.lock
.claude/*.lock

# Matt Pocock's engineering skills are installed as a user-scope Claude Code plugin
# (mattpocock-skills@mattpocock), not vendored here. Install with:
#   claude plugin marketplace add mattpocock/skills
#   claude plugin install mattpocock-skills@mattpocock
# docs/agents/ is that skill set's per-repo config (issue tracker, triage labels, domain
# docs); CLAUDE.local.md is the pointer to it that the skills read. Both are machine-local.
docs/agents/
CLAUDE.local.md
